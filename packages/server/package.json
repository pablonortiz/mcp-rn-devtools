{
  "name": "mcp-rn-devtools",
  "version": "0.3.0",
  "description": "MCP server for React Native runtime debugging \u2014 zero-config access to Redux state, AsyncStorage, actions, logs, network, and profiling from your running app",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-rn-devtools": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js",
    "prepack": "cp ../../README.md ./README.md"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "react-native",
    "devtools",
    "debugging",
    "claude",
    "hermes",
    "redux",
    "asyncstorage",
    "cdp",
    "metro"
  ],
  "license": "MIT",
  "author": "Pablo Nicol\u00e1s Ortiz (https://github.com/pablonortiz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablonortiz/mcp-rn-devtools.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/pablonortiz/mcp-rn-devtools#readme",
  "bugs": {
    "url": "https://github.com/pablonortiz/mcp-rn-devtools/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "source-map": "^0.7.6",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mcp-rn-devtools/shared": "workspace:*",
    "@types/ws": "^8.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
